# PostgreSQL connection used by Prisma at build and runtime.
# Local dev via docker compose (matches the postgres service in docker-compose.yml).
DATABASE_URL=postgresql://bloodbowl:bloodbowl@localhost:5432/bloodbowl?schema=public

# Secret used to sign Auth.js session/JWT cookies.
# Generate with: `openssl rand -base64 32`. DO NOT commit a real value.
AUTH_SECRET=replace-me-with-a-generate-random-secret

# Allow Auth.js over plain HTTP on a LAN host (e.g. 111.111.111.100).
# Set to "true" only in non-production/dev; production must sit behind HTTPS.
AUTH_TRUST_HOST=true

# Auth mode:
# - `local` (default): anonymous. Route protection OFF, teams stored in
#   localStorage. Used by the default unit/e2e suites.
# - `auth`: accounts + PostgreSQL persistence ON. Production MUST set `auth`.
AUTH_MODE=local

# Structured logging (lib/logger.ts): one JSON line per event on stdout/stderr,
# queryable with `docker logs <container> | jq`. Levels: debug | info | warn | error.
# Defaults to `debug` outside production and `info` in production.
LOG_LEVEL=info

# Public base URL, used to build absolute links inside notification emails.
# REQUIRED for those links to be clickable: without it the mail falls back to a
# relative path, which is useless in an inbox.
APP_URL=http://localhost:3444

# Email delivery (Resend HTTP API, no SDK). BOTH are required to actually send:
# when either is unset the app falls back to a `console` transport that logs the
# message instead of sending it, so dev and tests never need credentials.
# - RESEND_API_KEY: create one at https://resend.com/api-keys
# - MAIL_FROM: a sender verified in Resend, e.g. "Blood Bowl Teams <no-reply@example.com>"
RESEND_API_KEY=
MAIL_FROM=
