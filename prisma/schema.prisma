// Prisma schema for Blood Bowl Web.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Authenticated user account. Teams are cascade-deleted when a user is removed.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  teams        Team[]
}

/// A team owned by a single user, scoped via `userId`.
model Team {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  raceId     String
  leagueType String
  roster     Json
  coaching   Json
  createdAt  DateTime @default(now())
  /// When set, the team is archived (soft-deleted) and hidden from listings.
  archivedAt DateTime?

  @@index([userId])
}
