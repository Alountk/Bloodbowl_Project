// Prisma schema for Blood Bowl Web.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Authenticated user account. Teams and leagues are cascade-deleted when a user is removed.
model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  name              String?
  /// Adapter-issued avatar value (a `/uploads/...` path or a public S3 URL),
  /// or null when the user has no avatar. Never a client-supplied URL.
  avatar            String?
  /// RAU-58: the account-level UI language ("es" | "en"). Defaults to Spanish.
  /// The per-browser `bb-locale` cookie still applies to anonymous visitors,
  /// but the account locale wins whenever the user is signed in.
  locale            String             @default("es")
  createdAt         DateTime           @default(now())
  /// RBAC role (RAU-52): "user" (default) · "developer" (dev sections) ·
  /// "admin" (future platform management). Gates are server-side from the DB
  /// (the JWT carries the role only as a login-time snapshot).
  role              String             @default("user")
  /// RAU-52 billing tier — no payment logic yet, just the field + checks so
  /// feature flags can gate by plan later: "free" (default) · "club" · "premium".
  plan              String             @default("free")
  teams             Team[]
  leagues           League[]
  scheduleProposals ScheduleProposal[]
}

/// A user-owned group of teams. A league starts "open", locks when the owner
/// starts the round-robin season ("started"), and closes definitively when the
/// last fixture of the season is played ("finished"): the standings decide the
/// stored `championTeamId` and no more fixtures/results/negotiation are allowed.
model League {
  id           String       @id @default(cuid())
  name         String       @unique
  description  String?
  ownerId      String
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  status       LeagueStatus @default(open)
  seasonLength Int?
  startedAt    DateTime?
  /// RAU-40: the season champion (first row of the standings) when the league
  /// finished; null while open/started or when no result was ever recorded.
  championTeamId String?
  championTeam   Team?        @relation("LeagueChampion", fields: [championTeamId], references: [id], onDelete: SetNull)
  /// League-level turn-clock option (AC-10). Enabled toggle + per-turn duration
  /// in seconds (120|240|360; 240 default). Immutable after creation — the
  /// league creation API has no update path for it. When disabled, live matches
  /// run clockless (no ticking, no grace pause).
  turnClockEnabled Boolean @default(true)
  turnClockSeconds Int    @default(240)
  /// RAU-52: the ruleset this league plays under (picked at creation). Null for
  /// legacy leagues created before rulesets existed → today's default behavior.
  rulesetId String?
  ruleset   Ruleset? @relation(fields: [rulesetId], references: [id], onDelete: SetNull)
  teams        Team[]       @relation("LeagueMembers")
  fixtures     Fixture[]

  @@index([ownerId])
  @@index([rulesetId])
}

/// A reusable "Tipo de reglas" definition (RAU-52, developer-only section).
/// Every league picks one at creation; the seeded "Estándar BB2025" is the
/// default. The `races` column holds a JSON array of allowed race catalog ids
/// (a ruleset allowing every race stores all 31 ids — no wildcard).
model Ruleset {
  id               String   @id @default(cuid())
  name             String
  description      String?
  /// JSON array of allowed race ids from the 31-race catalog (never a wildcard).
  races            Json
  startingTreasury Int      @default(1000000)
  /// Optional Team Value cap in gold (null = no cap, "∞" in the UI).
  tvCap            Int?
  minPlayers       Int      @default(11)
  maxPlayers       Int      @default(16)
  /// Hire/fire window: "between-jornadas" (locked between matchdays) or "libre".
  hireFire         String   @default("between-jornadas")
  seasonReform     Boolean  @default(true)
  mercenaries      Boolean  @default(false)
  /// Active rulesets are offered in the league-creation selector; inactive ones
  /// stay editable by developers but are never offered to new leagues.
  active           Boolean  @default(true)
  /// Developer who created the ruleset (plain id reference, no FK to avoid
  /// coupling ruleset lifetime to the author's account).
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  leagues          League[]
}

/// Lifecycle state of a league: joinable/open, locked after a season starts, or
/// definitively closed once every fixture is played (champion declared, RAU-40).
enum LeagueStatus {
  open
  started
  finished
}

/// A scheduled round-robin pairing within a started league (one jornada round).
model Fixture {
  id          String    @id @default(cuid())
  leagueId    String
  league      League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  round       Int
  homeTeamId  String
  awayTeamId  String
  createdAt   DateTime  @default(now())
  /// When participants agree a date, the match is `scheduled` (null until then).
  scheduledAt DateTime?
  /// Set by the league owner's forfeit (walkover); derives the `played` status.
  winnerId    String?
  /// Final score recorded when the result loads; a walkover writes 0/2-style scores.
  homeScore   Int?
  awayScore   Int?
  /// The persisted match result record (populated by the result route).
  result      MatchResult?
  /// The (optional) live match row governing this fixture's realtime state.
  liveMatch   LiveMatch?

  homeTeam Team  @relation("FixtureHomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam Team  @relation("FixtureAwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  winner   Team? @relation("FixtureWinner", fields: [winnerId], references: [id], onDelete: Restrict)

  proposals ScheduleProposal[]

  @@index([leagueId, round])
}

/// Team side within a live match (home/away).
enum TeamSide {
  home
  away
}

/// Lifecycle of a live match: pending (created), ready (both coaches
/// consented, awaiting the first turn), live (in progress), finished.
enum LiveMatchStatus {
  pending
  ready
  live
  finished
}

/// The authoritative, DB-baselined state of an interactive live match (LM-6).
/// `seq` is the optimistic-concurrency guard: every transition bumps it via
/// `updateMany({ where: { id, seq: prev } })`; 0 rows ⇒ double-action → 409.
model LiveMatch {
  id            String          @id @default(cuid())
  fixtureId     String          @unique
  fixture       Fixture         @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  status        LiveMatchStatus @default(pending)
  half          Int             @default(1)
  turnNumber    Int             @default(1)
  /// Which team's coach is on the active turn (alternates per LM-4).
  activeSide    TeamSide        @default(home)
  homeClock     Int             @default(240)
  awayClock     Int             @default(240)
  homeScore     Int             @default(0)
  awayScore     Int             @default(0)
  /// Whether each coach has consented to start (LM-11). Both true → ready.
  homeConsented Boolean         @default(false)
  awayConsented Boolean         @default(false)
  /// Kickoff anchor: set once when the first turn begins (LM-5), informational.
  startedAt     DateTime?
  /// Unified clock accumulators in ms — server-derived, active side only (LM-5).
  homeTurnMs    Int             @default(0)
  awayTurnMs    Int             @default(0)
  /// Optimistic concurrency seq — monotonic, bump-or-409 (LM-6).
  seq           Int             @default(0)
  /// True when the active clock is paused by the disconnect policy (LM-7).
  paused        Boolean         @default(false)
  /// Re-purposed unified-clock running-segment start; null = paused/pre-live.
  clockStartedAt DateTime?
  finishedAt    DateTime?
  /// RAU-38: the side that proposed to concede, null until proposed / after the
  /// rival accepts or declines. Additive, never re-typed.
  concedeProposedBy TeamSide?
  /// RAU-39: the ACTIVE coach's pending casualty proposal (causer/victim/cause/
  /// rolls); null until proposed / after the defender confirms. Additive JSON,
  /// never re-typed.
  pendingCasualty   Json?
  /// RAU-44: the per-team match winnings persisted ONCE at live finish
  /// (`{ home, away }`, both in gold). Deterministic: the pre-match FF 1D3
  /// rolls at finish and is stored. Additive JSON, never re-typed; null until
  /// the live match reaches `finished`.
  winnings          Json?
  /// RAU-49 fix: the resolution the PREVIEW roll produced (`{ mvp: { home,
  /// away }, postFf: { home, away } }` — the chosen nominee rosterPlayerIds +
  /// the post-match FF totals, both from the SAME server roll the modal
  /// previewed). `resolveMatch` reuses these values at commit so the reported
  /// result always equals what the summary showed (never a second independent
  /// roll). Null until `rollMvp` runs on a finished live match; overwritten on
  /// re-roll. Additive JSON, never re-typed.
  pendingResolution Json?
  /// RAU-51: the PER-SIDE MJP nominations (`{ home: string[] | null, away:
  /// string[] | null }` — each side's six rosterPlayerIds, or null when that
  /// coach has not nominated yet). Each coach nominates ONLY their own team;
  /// the value survives reloads/SSE and `rollMvp`/`resolveMatch` require BOTH
  /// sides before rolling. `pendingResolution` stays separate — it holds the
  /// ROLLED result. Additive JSON, never re-typed; null until the first side
  /// nominates.
  mvpNominations    Json?
  /// The PER-SIDE end-of-match resolution wizard cursor (`{ home: { step,
  /// fansDone, fans, mvpConfirmed, mvpRolled, casualtiesDone, journeymenDone },
  /// away: {...} }`). Each coach advances THEIR OWN side independently through
  /// the 5 steps (ganancias/mantenimiento → fans → MVP → reveal+bajas →
  /// novatos); a refresh resumes at the persisted step. Only the MVP reveal
  /// waits for BOTH sides; the match closes when BOTH sides reach "done".
  /// Additive JSON, never re-typed; null until the wizard's first action.
  resolutionState    Json?
  /// RAU-14: the journeymen (Novatos) fielded at begin, persisted so the
  /// post-resolve HIRE flow can reference them (`{ home: [{ id, name }],
  /// away: [{ id, name }] }` — each journeyman's synthetic id + deterministic
  /// race-bank name). A side that fields none carries an empty array. Additive
  /// JSON, never re-typed; null until the match begins (or for a match with no
  /// LiveMatch row).
  journeymen        Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  events        LiveEvent[]

  @@index([fixtureId])
}

/// An append-only, monotonically-sequenced live event (TD/casualty/foul/
/// endHalf/endMatch). `seq` is authoritative via `@@unique([liveMatchId, seq])`.
model LiveEvent {
  id            String    @id @default(cuid())
  liveMatchId   String
  liveMatch     LiveMatch @relation(fields: [liveMatchId], references: [id], onDelete: Cascade)
  seq           Int
  kind          String
  side          TeamSide?
  playerRosterId String?
  half          Int
  turnNumber    Int
  payload       Json      @default("{}")
  createdAt     DateTime  @default(now())
  /// Non-blocking acknowledgement (design B): the RIVAL marks the card
  /// "ok" (seen & correct) or "nok" (discrepancy). Defaults to "pending";
  /// the UI derives "auto-verified" after the ack timeout without a response —
  /// the act is ALWAYS consumed, the ack is informational only.
  ackStatus     String    @default("pending")
  /// When the rival acknowledged the card (ok/nok).
  ackAt         DateTime?
  /// The user id of the coach who acknowledged.
  ackedBy       String?

  @@unique([liveMatchId, seq])
}

/// A proposed match date for a fixture, created by one of the two participants.
/// At most one proposal is active per fixture: `acceptedAt` and `closedAt` null.
model ScheduleProposal {
  id         String    @id @default(cuid())
  fixtureId  String
  fixture    Fixture   @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  createdAt  DateTime  @default(now())
  /// Set when the other participant accepts this proposal (then scheduledAt = date).
  acceptedAt DateTime?
  /// Set when the proposal is closed by a counter-propose or a forfeit.
  closedAt   DateTime?

  @@index([fixtureId, createdAt])
}

/// A team owned by a single user, scoped via `userId`.
model Team {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  raceId       String
  roster       Json
  coaching     Json
  createdAt    DateTime  @default(now())
  /// When set, the team is archived (soft-deleted) and hidden from listings.
  archivedAt   DateTime?
  /// The league this team belongs to, if any. Set to null when expeled or the league is deleted.
  leagueId     String?
  league       League?   @relation("LeagueMembers", fields: [leagueId], references: [id], onDelete: SetNull)
  /// Post-match winnings balance in gold coins (0 until the first result loads).
  treasury     Int       @default(0)
  /// RAU-56: the treasury base the team was created with (1M default, or the
  /// league ruleset's `startingTreasury` when the team was created joining a
  /// league). The spendable balance is `startingTreasury + treasury - costs`.
  startingTreasury Int   @default(1000000)
  homeFixtures Fixture[] @relation("FixtureHomeTeam")
  awayFixtures Fixture[] @relation("FixtureAwayTeam")
  wonFixtures  Fixture[] @relation("FixtureWinner")
  players      Player[]
  /// RAU-40: leagues this team won (one per finished league whose standings
  /// ranked it first).
  championedLeagues League[] @relation("LeagueChampion")

  @@index([userId])
  @@index([leagueId])
}

/// BB2025 post-match resolution record persisted when a result loads.
model MatchResult {
  id         String                 @id @default(cuid())
  fixtureId  String                 @unique
  fixture    Fixture                @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  weather    String?
  /// Snapshot of the two final scoreboards (home/away scores, winner).
  scores     Json
  /// Petty cash awarded to the lower-Total-Value team, stored in gold coins.
  pettyCash  Int?
  loadedBy   String
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  corrections MatchResultCorrection[]

  @@index([fixtureId])
}

/// Admin-only audit trail of a result correction (before/after snapshot).
model MatchResultCorrection {
  id          String     @id @default(cuid())
  resultId    String
  result      MatchResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  correctedBy String
  before      Json
  after       Json
  correctedAt DateTime   @default(now())
}

/// Reconciliation row for a single roster player: owns progression state only.
model Player {
  id                 String             @id @default(cuid())
  teamId             String
  team               Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rosterPlayerId     String
  name               String
  positionalKey      String
  /// Primary experience balance used to purchase improvements.
  pe                 Int                @default(0)
  /// Acquired skill ids (`SkillId[]` as JSON).
  skills             Json
  /// Recorded injury outcomes (`string[]` as JSON).
  injuries           Json
  alive              Boolean            @default(true)
  /// Lasting-band victims are unavailable for the team's NEXT match (RAU-12).
  missNextMatch      Boolean            @default(false)
  /// Value added by acquired skills (+10.000 normal, +20.000 élite).
  valueBonus         Int                @default(0)
  /// Improvement history (cost table rows applied, `Json[]` as JSON).
  improvements       Json
  /// Named attribute increases applied (e.g. `{"mv":1}`, `Json`).
  attributeIncreases Json
  pendingRolls       PlayerPendingRoll[]

  @@unique([teamId, rosterPlayerId])
  @@index([teamId])
}

/// Server-owned pending skill-roll/pick state (rolls before the player picks).
model PlayerPendingRoll {
  id        String   @id @default(cuid())
  playerId  String   @unique
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  roll1     Int
  roll2     Int?
  kind      String
  createdAt DateTime @default(now())
}
