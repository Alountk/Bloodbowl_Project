// Prisma schema for Blood Bowl Web.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Authenticated user account. Teams and leagues are cascade-deleted when a user is removed.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  teams        Team[]
  leagues      League[]
}

/// A user-owned group of teams.
model League {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  teams       Team[]   @relation("LeagueMembers")

  @@index([ownerId])
}

/// A team owned by a single user, scoped via `userId`.
model Team {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  raceId     String
  roster     Json
  coaching   Json
  createdAt  DateTime @default(now())
  /// When set, the team is archived (soft-deleted) and hidden from listings.
  archivedAt DateTime?
  /// The league this team belongs to, if any. Set to null when expeled or the league is deleted.
  leagueId   String?
  league     League?  @relation("LeagueMembers", fields: [leagueId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([leagueId])
}
